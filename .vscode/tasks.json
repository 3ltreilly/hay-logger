{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "makeM",
            "type": "shell",
            "command": "${command:python.interpreterPath} manage.py makemigrations"
        },
        {
            // run after a merged PR's Actions run has pushed the new image
            "label": "Deploy to milhouse",
            "type": "shell",
            "command": "${workspaceFolder}/deploy.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "type": "docker-build",
            "label": "docker-build",
            "platform": "python",
            "dockerBuild": {
                "tag": "hay-logger:latest",
                "dockerfile": "${workspaceFolder}/Dockerfile",
                "context": "${workspaceFolder}",
                "pull": true
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build"
            ],
            "dockerRun": {
                "volumes": [
                    {
                        "localPath": "${workspaceFolder}/db",
                        "containerPath": "/app/db",
                        "permissions": "rw"
                    },
                ]
            },
            "python": {
                "args": [
                    "runserver",
                    "0.0.0.0:8000",
                    "--nothreading",
                    "--noreload"
                ],
                "file": "manage.py"
            }
        }
    ]
}
